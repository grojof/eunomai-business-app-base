# Copy to .env for local work. In production, set these in the service's environment.
# Behind a proxy, start with: uv run uvicorn app.main:app --no-proxy-headers
APP_ENVIRONMENT=development
APP_TIME_ZONE=UTC
APP_FAKE_IDENTITY=true
APP_FAKE_GROUPS=["demo-admins"]
APP_ROLE_GROUPS={"admin":["demo-admins"]}
