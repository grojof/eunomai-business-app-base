# Copy to .env for local work. In production, set these in the service's environment.
# Behind a proxy, start with: uv run uvicorn app.main:app --no-proxy-headers
APP_ENVIRONMENT=development
APP_TIME_ZONE=UTC
# Without this, a SQLite file in .data/, which needs nothing installed. Production refuses SQLite.
# APP_DATABASE_URL=postgresql+psycopg://application@localhost/application
# Uploads are kept here, outside anything served. Without this, in .data/uploads, which git ignores.
# APP_UPLOAD_FOLDER=/srv/application/uploads
APP_FAKE_IDENTITY=true
APP_FAKE_GROUPS=["demo-admins"]
APP_ROLE_GROUPS={"admin":["demo-admins"]}
