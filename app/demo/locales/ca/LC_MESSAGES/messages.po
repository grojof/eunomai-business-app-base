msgstr "Feina"

msgid "Work by location"
msgstr "Feina per ubicació"

#, python-format
msgid ""
"Work cost %(total)s this year. The dearest month was %(month)s, at "
"%(cost)s."
msgstr ""
"La feina va costar %(total)s aquest any. El mes més car va ser %(month)s,"
" amb %(cost)s."

msgid "Work done on this equipment will appear here."
msgstr "La feina feta en aquest equip apareixerà aquí."

#, python-format
msgid "Work order %(number)s"
msgstr "Ordre de treball %(number)s"

#, python-format
msgid "Work order %(number)s saved."
msgstr "Ordre de treball %(number)s desada."

msgid "Work order for the cooling tower"
msgstr "Ordre de treball de la torre de refrigeració"

msgid "Work orders"
msgstr "Ordres de treball"

#, python-format
msgid "Work orders (%(count)s)"
msgstr "Ordres de treball (%(count)s)"

