   "html": "<!--\n* Import Cally web component from CDN\n<script type=\"module\" src=\"https://unpkg.com/cally\"></script>\n\n* Or install as a dependency:\nnpm i cally\n* and import it in JS\nimport \"cally\";\n-->\n\n<button popovertarget=\"cally-popover1\" class=\"input\" id=\"cally1\" data-style=\"anchor-name:--cally1\">\n  Pick a date\n</button>\n<div popover id=\"cally-popover1\" class=\"dropdown bg-base-100 rounded-box shadow-lg\" data-style=\"position-anchor:--cally1\">\n  <calendar-date class=\"cally\" onchange=\"document.getElementById('cally1').innerText = this.value\">\n    <svg aria-label=\"Previous\" class=\"fill-current size-4\" slot=\"previous\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M15.75 19.5 8.25 12l7.5-7.5\"></path></svg>\n    <svg aria-label=\"Next\" class=\"fill-current size-4\" slot=\"next\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m8.25 4.5 7.5 7.5-7.5 7.5\"></path></svg>\n    <calendar-month></calendar-month>\n  </calendar-date>\n</div>",
