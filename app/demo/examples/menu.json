{
 "name": "menu",
 "title": {
  "en": "Menu"
 },
 "description": {
  "en": "Menu is used to display a list of links vertically or horizontally.",
  "ca": "El menú s'utilitza per mostrar una llista d'enllaços de manera vertical o horitzontal.",
  "es": "Menu se utiliza para mostrar una lista de enlaces vertical u horizontalmente."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "menu",
     "description": {
      "en": "For <ul> tag",
      "ca": "Per a l'etiqueta <ul>",
      "es": "Para etiqueta <ul>"
     }
    }
   ]
  },
  {
   "group": "part",
   "items": [
    {
     "class": "menu-title",
     "description": {
      "en": "Styles a <li> as title. Title is not interactive"
     }
    },
    {
     "class": "menu-dropdown",
     "description": {
      "en": "For the collapsible <ul> if you want to show it using JS",
      "ca": "Per al <ul> plegable si el voleu mostrar amb JS",
      "es": "Para el <ul> plegable si desea mostrarlo usando JS"
     }
    },
    {
     "class": "menu-dropdown-toggle",
     "description": {
      "en": "For the toggle to show/hide the menu-dropdown using JS",
      "ca": "Perquè el Toggle mostri/oculti el Menu-Dropdown mitjançant JS",
      "es": "Para que Toggle muestre/oculte Menu-Dropdown usando JS"
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "menu-disabled",
     "description": {
      "en": "For the element inside <li> to look disabled",
      "ca": "Perquè l'element dins de <li> sembli desactivat",
      "es": "Para que el elemento dentro de <li> parezca deshabilitado"
     }
    },
    {
     "class": "menu-active",
     "description": {
      "en": "For the element inside <li> to look active",
      "ca": "Perquè l'element dins de <li> sembli actiu",
      "es": "Para que el elemento dentro de <li> parezca activo"
     }
    },
    {
     "class": "menu-focus",
     "description": {
      "en": "For the element inside <li> to look focused",
      "ca": "Perquè l'element dins <li> sembli enfocat",
      "es": "Para que el elemento dentro de <li> parezca enfocado"
     }
    },
    {
     "class": "menu-dropdown-show",
     "description": {
      "en": "Shows the menu-dropdown-toggle and menu-dropdown collapsible submenu using JS",
      "ca": "Mostra el subMenu plegable Menu-Dropdown-Toggle i Menu-Dropdown mitjançant JS",
      "es": "Muestra el subMenu plegable Menu-Dropdown-Toggle y Menu-Dropdown usando JS"
     }
    },
    {
     "class": "menu-paged",
     "description": {
      "en": "Shows one level at a time and turns the open summary into a back button"
     }
    }
   ]
  },
  {
   "group": "size",
   "items": [
    {
     "class": "menu-xs",
     "description": {
      "en": "Extra small size",
      "ca": "Talla extra petita",
      "es": "Tamaño muy pequeño"
     }
    },
    {
     "class": "menu-sm",
     "description": {
      "en": "Small size",
      "ca": "Talla petita",
      "es": "tamaño pequeño"
     }
    },
    {
     "class": "menu-md",
     "description": {
      "en": "Medium size",
      "ca": "Talla mitjana",
      "es": "tamaño mediano"
     },
     "default": true
    },
    {
     "class": "menu-lg",
     "description": {
      "en": "Large size",
      "ca": "Talla gran",
      "es": "tamaño grande"
     }
    },
    {
     "class": "menu-xl",
     "description": {
      "en": "Extra large size",
      "ca": "Talla extra gran",
      "es": "tamaño extra grande"
     }
    }
   ]
  },
  {
   "group": "direction",
   "items": [
    {
     "class": "menu-vertical",
     "description": {
      "en": "Vertical menu (default)",
      "ca": "Menu vertical (Default)",
      "es": "Vertical Menu (Default)"
     }
    },
    {
     "class": "menu-horizontal",
     "description": {
      "en": "Horizontal menu",
      "ca": "Menu horitzontal",
      "es": "Horizontal Menu"
     }
    }
   ]
  }
 ],
