{
 "name": "stack",
 "title": {
  "en": "Stack"
 },
 "description": {
  "en": "Stack visually puts elements on top of each other.",
  "ca": "Una pila posa visualment els elements uns sobre els altres.",
  "es": "Stack coloca elementos visualmente uno encima del otro."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "stack",
     "description": {
      "en": "Puts the children elements on top of each other",
      "ca": "Posa els elements infantils uns sobre els altres",
      "es": "Pone los elementos secundarios uno encima del otro."
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "stack-top",
     "description": {
      "en": "Aligns the children elements to the top",
      "ca": "Alinea els elements infantils a la part superior",
      "es": "Alinea los elementos secundarios con la parte superior."
     }
    },
    {
     "class": "stack-bottom",
     "description": {
      "en": "Aligns the children elements to the bottom",
      "ca": "Alinea els elements infantils a la part inferior",
      "es": "Alinea los elementos secundarios con la parte inferior."
     },
     "default": true
    },
    {
     "class": "stack-start",
     "description": {
      "en": "Aligns the children elements to the start (horizontally)",
      "ca": "Alinea els elements secundaris a l'inici (horitzontalment)",
      "es": "Alinea los elementos secundarios al inicio (horizontalmente)"
     }
    },
    {
     "class": "stack-end",
     "description": {
      "en": "Aligns the children elements to the end (horizontally)",
      "ca": "Alinea els elements infantils fins al final (horitzontalment)",
      "es": "Alinea los elementos secundarios hasta el final (horizontalmente)"
     }
    }
   ]
  }
 ],
