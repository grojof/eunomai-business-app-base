{
 "name": "rating",
 "title": {
  "en": "Rating"
 },
 "description": {
  "en": "Rating is a set of radio buttons that allow the user to rate something.",
  "ca": "El Rating és un conjunt de botons de radio que permet a l'usuari puntuar alguna cosa.",
  "es": "Rating es un conjunto de botones de radio que permiten al usuario calificar algo."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "rating",
     "description": {
      "en": "For a div containing radio inputs",
      "ca": "Per a un div que conté entrades Radio",
      "es": "Para un div que contiene entradas de radio"
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "rating-half",
     "description": {
      "en": "To shows half of the shapes. Useful for half star ratings",
      "ca": "A mostra la meitat de les formes. Útil per a les qualificacions de mitja estrella",
      "es": "Para mostrar la mitad de las formas. Útil para calificaciones de media estrella"
     }
    },
    {
     "class": "rating-hidden",
     "description": {
      "en": "For the first radio to make it hidden so user can clear the rating",
      "ca": "Perquè el primer Radio s'oculti perquè l'usuari pugui esborrar el Rating",
      "es": "Para el primer Radio, ocultarlo para que el usuario pueda borrar el Rating."
     }
    }
   ]
  },
  {
   "group": "size",
   "items": [
    {
     "class": "rating-xs",
     "description": {
      "en": "Extra small size",
      "ca": "Talla extra petita",
      "es": "Tamaño muy pequeño"
     }
    },
    {
     "class": "rating-sm",
     "description": {
      "en": "Small size",
      "ca": "Talla petita",
      "es": "tamaño pequeño"
     }
    },
    {
     "class": "rating-md",
     "description": {
      "en": "Medium size",
      "ca": "Talla mitjana",
      "es": "tamaño mediano"
     },
     "default": true
    },
    {
     "class": "rating-lg",
     "description": {
      "en": "Large size",
      "ca": "Talla gran",
      "es": "tamaño grande"
     }
    },
    {
     "class": "rating-xl",
     "description": {
      "en": "Extra large size",
      "ca": "Talla extra gran",
      "es": "tamaño extra grande"
     }
    }
   ]
  }
