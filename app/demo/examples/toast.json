     "description": {
      "en": "align horizontally to the right",
      "ca": "alinear horitzontalment a la dreta",
      "es": "alinear horizontalmente a la derecha"
     },
     "default": true
    },
    {
     "class": "toast-top",
     "description": {
      "en": "align vertically to top",
      "ca": "alinear verticalment cap a dalt",
      "es": "alinear verticalmente hacia arriba"
