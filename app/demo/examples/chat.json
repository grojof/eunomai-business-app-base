    "en": "chat-start and chat-end"
   },
   "subtitle": null,
   "html": "<div class=\"chat chat-start\">\n  <div class=\"chat-bubble\">\n    It's over Anakin,\n    <br />\n    I have the high ground.\n  </div>\n</div>\n<div class=\"chat chat-end\">\n  <div class=\"chat-bubble\">You underestimate my power!</div>\n</div>",
