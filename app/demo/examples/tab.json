{
 "name": "tab",
 "title": {
  "en": "Tabs"
 },
 "description": {
  "en": "Tabs can be used to show a list of links in a tabbed format.",
  "ca": "Les pestanyes es poden utilitzar per mostrar una llista d'enllaços en un format de pestanyes.",
  "es": "Tabs se pueden usar para mostrar una lista de enlaces en formato de pestañas."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "tabs",
     "description": {
      "en": "Container of multiple tab items",
      "ca": "Contenidor de diverses pestanyes",
      "es": "Contenedor de elementos de múltiples pestañas"
     }
    }
   ]
  },
  {
   "group": "part",
   "items": [
    {
     "class": "tab",
     "description": {
      "en": "A single tab button (can be button, link, div, radio input, etc)",
      "ca": "Una sola pestanya Button (pot ser Button, Link, div, Radio entrada, etc.)",
      "es": "Una sola pestaña Button (puede ser entrada Button, Link, div, Radio, etc.)"
     }
    },
    {
     "class": "tab-content",
     "description": {
      "en": "Tab content that comes immediately after a tab",
      "ca": "Contingut de pestanya que ve immediatament després d'una pestanya",
      "es": "Contenido de la pestaña que viene inmediatamente después de una pestaña"
     }
    }
   ]
  },
  {
   "group": "style",
   "items": [
    {
     "class": "tabs-box",
     "description": {
      "en": "box style",
      "ca": "estil caixa",
      "es": "estilo de caja"
     }
    },
    {
     "class": "tabs-border",
     "description": {
      "en": "bottom border style",
      "ca": "estil de vora inferior",
      "es": "estilo de borde inferior"
     }
    },
    {
     "class": "tabs-lift",
     "description": {
      "en": "lift style",
      "ca": "estil d'elevació",
      "es": "estilo de elevación"
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "tab-active",
     "description": {
      "en": "Makes a single tab look active",
      "ca": "Fa que una sola pestanya sembli activa",
      "es": "Hace que una sola pestaña parezca activa"
     }
    },
    {
     "class": "tab-disabled",
     "description": {
      "en": "Makes a single tab look disabled",
      "ca": "Fa que una sola pestanya sembli desactivada",
      "es": "Hace que una sola pestaña parezca deshabilitada"
     }
    }
   ]
  },
  {
   "group": "placement",
   "items": [
    {
     "class": "tabs-top",
     "description": {
      "en": "Puts tab buttons on top of the tab-content (default)",
      "ca": "Posa els botons de la pestanya a la part superior del contingut de la pestanya (Default)",
      "es": "Coloca los botones de pestaña encima del contenido de la pestaña (Default)"
     }
    },
    {
     "class": "tabs-bottom",
     "description": {
      "en": "Puts tabs on under the tab-content",
      "ca": "Posa Tabs sota el contingut de la pestanya",
      "es": "Pone Tabs debajo del contenido de la pestaña"
     }
    }
   ]
  },
  {
   "group": "size",
   "items": [
    {
     "class": "tabs-xs",
