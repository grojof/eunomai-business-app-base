{
 "name": "indicator",
 "title": {
  "en": "Indicator"
 },
 "description": {
  "en": "Indicators are used to place an element on the corner of another element.",
  "ca": "Els Indicadors s'utilitzen per col·locar un element a la cantonada d'un altre element.",
  "es": "Indicators se utilizan para colocar un elemento en la esquina de otro elemento."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "indicator",
     "description": {
      "en": "Container element",
      "ca": "Element contenidor",
      "es": "Elemento contenedor"
     }
    }
   ]
  },
  {
   "group": "part",
   "items": [
    {
     "class": "indicator-item",
     "description": {
      "en": "will be placed on the corner of sibling",
      "ca": "will be placed on the corner of same-level element",
      "es": "will be placed on the corner of same-level element"
     }
    }
   ]
  },
  {
   "group": "placement",
   "items": [
    {
     "class": "indicator-start",
     "description": {
      "en": "align horizontally to the start",
      "ca": "alinear horitzontalment a l'inici",
      "es": "alinear horizontalmente al inicio"
     }
    },
    {
     "class": "indicator-center",
     "description": {
      "en": "align horizontally to the center",
      "ca": "alinear horitzontalment al centre",
      "es": "alinear horizontalmente al centro"
     }
    },
    {
     "class": "indicator-end",
     "description": {
      "en": "align horizontally to the end",
      "ca": "alinear horitzontalment fins al final",
      "es": "alinear horizontalmente hasta el final"
     },
     "default": true
    },
    {
     "class": "indicator-top",
     "description": {
      "en": "align vertically to top",
      "ca": "alinear verticalment cap a dalt",
      "es": "alinear verticalmente hacia arriba"
     },
     "default": true
    },
    {
     "class": "indicator-middle",
     "description": {
      "en": "align vertically to middle",
      "ca": "alinear verticalment al mig",
      "es": "alinear verticalmente al medio"
     }
    },
    {
     "class": "indicator-bottom",
     "description": {
      "en": "align vertically to bottom",
      "ca": "alinear verticalment a baix",
      "es": "alinear verticalmente hacia abajo"
     }
    }
   ]
  }
 ],
