{
 "name": "list",
 "title": {
  "en": "List"
 },
 "description": {
  "en": "List is a vertical layout to display information in rows.",
  "ca": "La llista és un disseny vertical per mostrar informació en files.",
  "es": "La lista es un diseño vertical para mostrar información en filas."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "list",
     "description": {
      "en": "A vertical flex layout to include list rows",
      "ca": "Un disseny flexible vertical per incloure files de llista",
      "es": "Un diseño flexible vertical para incluir filas de lista"
     }
    },
    {
     "class": "list-row",
     "description": {
      "en": "The item inside list. A horizontal grid layout to include data",
      "ca": "L'element dins de la llista. Un disseny de quadrícula horitzontal per incloure dades",
      "es": "El elemento dentro de la lista. Un diseño de cuadrícula horizontal para incluir datos."
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "list-col-wrap",
     "description": {
      "en": "For one of direct children of list-row to push it to the next line",
      "ca": "Perquè un dels fills directes de list-row l'enviï a la línia següent",
      "es": "Para que uno de los hijos directos de list-row lo empuje a la siguiente línea"
     }
    },
    {
     "class": "list-col-grow",
     "description": {
      "en": "For one of direct children of list-row to make it fill the remaining space",
      "ca": "Per a un dels fills directes de list-row perquè ompli l'espai restant",
      "es": "Para que uno de los hijos directos de list-row llene el espacio restante"
     }
    }
   ]
  }
 ],
