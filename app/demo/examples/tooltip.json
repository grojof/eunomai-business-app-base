{
 "name": "tooltip",
 "title": {
  "en": "Tooltip"
 },
 "description": {
  "en": "Tooltip can be used to show a message when hovering over an element.",
  "ca": "El tooltip es pot utilitzar per mostrar un missatge quan es passa el cursor per sobre d'un element.",
  "es": "Tooltip se puede utilizar para mostrar un mensaje al pasar el cursor sobre un elemento."
 },
 "classes": [
  {
   "group": "component",
   "items": [
    {
     "class": "tooltip",
     "description": {
      "en": "Container element",
      "ca": "Element contenidor",
      "es": "Elemento contenedor"
     }
    }
   ]
  },
  {
   "group": "part",
   "items": [
    {
     "class": "tooltip-content",
     "description": {
      "en": "Optional. Setting a div as the content of the tooltip instead of the `data-tip` text",
      "ca": "Opcional. Configuració d'un div com a contingut del Tooltip en lloc del text `data-tip`.",
      "es": "Opcional. Establecer un div como contenido del Tooltip en lugar del texto de \"consejo de datos\" (`data-tip`)"
     }
    }
   ]
  },
  {
   "group": "placement",
   "items": [
    {
     "class": "tooltip-top",
     "description": {
      "en": "Put tooltip on top",
      "ca": "Posa Tooltip a sobre",
      "es": "Pon Tooltip encima"
     },
     "default": true
    },
    {
     "class": "tooltip-bottom",
     "description": {
      "en": "Put tooltip on bottom",
      "ca": "Posa Tooltip a la part inferior",
      "es": "Pon Tooltip en la parte inferior."
     }
    },
    {
     "class": "tooltip-left",
     "description": {
      "en": "Put tooltip on left",
      "ca": "Posa Tooltip a l'esquerra",
      "es": "Pon Tooltip a la izquierda."
     }
    },
    {
     "class": "tooltip-right",
     "description": {
      "en": "Put tooltip on right",
      "ca": "Posa Tooltip a la dreta",
      "es": "Pon Tooltip a la derecha"
     }
    },
    {
     "class": "tooltip-start",
     "description": {
      "en": "Align tooltip on start",
      "ca": "Alineeu Tooltip a l'inici",
      "es": "Alinear Tooltip al inicio"
     }
    },
    {
     "class": "tooltip-center",
     "description": {
      "en": "Align tooltip on center",
      "ca": "Alineeu Tooltip al centre",
      "es": "Alinear Tooltip en el centro"
     }
    },
    {
     "class": "tooltip-end",
     "description": {
      "en": "Align tooltip on end",
      "ca": "Alineeu Tooltip al final",
      "es": "Alinear Tooltip al final"
     }
    }
   ]
  },
  {
   "group": "modifier",
   "items": [
    {
     "class": "tooltip-open",
     "description": {
      "en": "Force open tooltip",
      "ca": "Força l'obertura Tooltip",
      "es": "Forzar apertura Tooltip"
     }
    }
   ]
  },
  {
   "group": "color",
   "items": [
    {
     "class": "tooltip-primary",
     "description": {
      "en": "primary color"
     }
    },
    {
     "class": "tooltip-secondary",
     "description": {
      "en": "secondary color"
     }
    },
    {
     "class": "tooltip-accent",
     "description": {
      "en": "accent color"
     }
    },
    {
     "class": "tooltip-info",
     "description": {
      "en": "info color"
     }
    },
    {
     "class": "tooltip-success",
     "description": {
      "en": "success color"
     }
    },
    {
