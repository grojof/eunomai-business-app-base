{
 "name": "dropdown",
 "title": {
  "en": "Dropdown"
 },
 "description": {
  "en": "Dropdown can open a menu or any other element when the button is clicked.",
  "ca": "El desplegable pot obrir un menú o qualsevol altre element quan es fa clic al botó.",
  "es": "Dropdown puede abrir un menú o cualquier otro elemento cuando se hace clic en el botón."
 },
