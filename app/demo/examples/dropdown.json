     "description": {
      "en": "Open from top",
      "ca": "Obriu des de dalt",
      "es": "Abierto desde arriba"
     }
    },
    {
     "class": "dropdown-bottom",
     "description": {
      "en": "Open from bottom",
      "ca": "Obriu des de baix",
      "es": "Abierto desde abajo"
     },
     "default": true
    },
    {
     "class": "dropdown-left",
     "description": {
      "en": "Open from left",
      "ca": "Obre des de l'esquerra",
      "es": "Abierto desde la izquierda"
