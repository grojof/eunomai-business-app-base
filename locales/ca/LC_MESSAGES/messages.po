#, python-format
msgid ""
"%(count)s. Showing %(first)s to %(last)s, sorted by %(column)s, "
"%(direction)s."
msgstr ""
"%(count)s. Es mostren del %(first)s al %(last)s, ordenats per %(column)s,"
" %(direction)s."

msgid "(optional)"
msgstr "(opcional)"

msgid ""
"A figure with its text summary and its data as a table, drawn with "
"Chart.js."
msgstr ""
"Una figura amb el seu resum en text i les seves dades en una taula, "
"dibuixada amb Chart.js."

msgid "A list of terms and their values, for one record's details."
msgstr "Una llista de termes i els seus valors, per als detalls d'un registre."

msgid "A list to type in, by keyboard, that is a plain select without JavaScript."
msgstr ""
"Una llista on es pot escriure, amb el teclat, que sense JavaScript és un "
"select normal."

msgid ""
"A plain form that filters a list on the server. daisyUI's filter is a set"
" of radio buttons."
msgstr ""
"Un formulari senzill que filtra una llista al servidor. El filter de "
"daisyUI és un grup de botons d'opció."

msgid "Actions"
msgstr "Accions"

msgid ""
"Any of Lucide's icons, or one of the organization's, hidden from screen "
"readers."
msgstr ""
"Qualsevol icona de Lucide, o una de l'organització, amagada per als "
"lectors de pantalla."

msgid "Apply"
msgstr "Aplica"

msgid "Approved"
msgstr "Aprovat"

msgid "As the page"
msgstr "Com la pàgina"

msgid "As the system"
msgstr "Com el sistema"

msgid "Ask whoever manages this application if you need access."
msgstr "Si necessites accés, demana'l a qui gestiona aquesta aplicació."

msgid "Asks before an action that cannot be undone, and names what will be lost."
msgstr "Pregunta abans d'una acció que no es pot desfer i diu què es perdrà."

msgid "Available"
msgstr "Disponible"

msgid "Back to the start"
msgstr "Torna a l'inici"

msgid "Breadcrumbs"
msgstr "Fil d'Ariadna"

msgid "Centred"
msgstr "Centrat"

msgid ""
"Change how this application looks for you. Each choice applies at once "
"and is remembered in this browser."
msgstr ""
"Canvia com es veu aquesta aplicació per a tu. Cada opció s'aplica de "
"seguida i es recorda en aquest navegador."

msgid "Chart"
msgstr "Gràfic"

msgid "Check the address, or go back to the start."
msgstr "Comprova l'adreça o torna a l'inici."

msgid "Clear all"
msgstr "Treu-los tots"

msgid "Close"
msgstr "Tanca"

msgid "Close this message"
msgstr "Tanca aquest missatge"

msgid "Compact"
msgstr "Compacta"

msgid "Confirmation dialog"
msgstr "Diàleg de confirmació"

msgid "Conflict notice"
msgstr "Avís de conflicte"

msgid "Copied"
msgstr "Copiat"

msgid "Copy"
msgstr "Copia"

msgid "Dark"
msgstr "Fosc"

msgid "Dark theme"
msgstr "Tema fosc"

msgid "Data display"
msgstr "Mostrar dades"

msgid "Data input"
msgstr "Entrada de dades"

msgid "Data table"
msgstr "Taula de dades"

msgid "Date field"
msgstr "Camp de data"

msgid "Decorative"
msgstr "Decoratiu"

msgid "Dense"
msgstr "Denses"

msgid "Dense rows"
msgstr "Files denses"

msgid "Density"
msgstr "Densitat"

msgid "Description list"
msgstr "Llista de descripcions"

msgid "Done"
msgstr "Fet"

msgid "Dropdown"
msgstr "Desplegable"

msgid "Each one is real: try it here, then choose the one the header should show."
msgstr "Cada un és real: prova'l aquí i tria el que ha de mostrar la capçalera."

#, python-format
msgid "Enter a date between %(earliest)s and %(latest)s."
msgstr "Escriu una data entre %(earliest)s i %(latest)s."

#, python-format
msgid "Enter a number between %(low)s and %(high)s."
msgstr "Escriu un nombre entre %(low)s i %(high)s."

#, python-format
msgid "Enter a number, such as %(example)s."
msgstr "Escriu un nombre, per exemple %(example)s."

#, python-format
msgid "Enter a whole number between %(low)s and %(high)s."
msgstr "Escriu un nombre enter entre %(low)s i %(high)s."

msgid "Error"
msgstr "Error"

msgid "Error summary"
msgstr "Resum d'errors"

msgid "Every list offers this too, above its rows."
msgstr "Cada llista també ho ofereix, damunt de les seves files."

msgid "Every problem of a form in one place, each a link to its field."
msgstr ""
"Tots els problemes d'un formulari en un sol lloc, cadascun amb un enllaç "
"al seu camp."

msgid "Feedback"
msgstr "Avisos"

msgid "Field error"
msgstr "Error de camp"

msgid "Filter bar"
msgstr "Barra de filtres"

msgid "Filters"
msgstr "Filtres"

msgid "Fixed header"
msgstr "Capçalera fixa"

msgid "Form actions"
msgstr "Accions del formulari"

msgid "Full"
msgstr "Completa"

msgid "Go back and choose a smaller file."
msgstr "Torna enrere i tria un fitxer més petit."

msgid "Go back and try again. If it happens again, tell whoever runs this."
msgstr ""
"Torna enrere i torna-ho a provar. Si torna a passar, avisa qui gestiona "
"això."

msgid "Hidden"
msgstr "Oculta"

msgid "How the language control looks"
msgstr "Com es veu el control d'idioma"

msgid "How the list is shown"
msgstr "Com es mostra la llista"

msgid "How the theme control looks"
msgstr "Com es veu el control de tema"

msgid "Icon"
msgstr "Icona"

msgid "Icons only"
msgstr "Només icones"

msgid "In the page"
msgstr "A la pàgina"

msgid "In the top bar"
msgstr "A la barra superior"

msgid "In use"
msgstr "En ús"

msgid "Information"
msgstr "Informació"

msgid "It is not your fault. Try again in a moment."
msgstr "No és culpa teva. Torna-ho a provar d'aquí a un moment."

msgid ""
"It only styles a calendar library, which is not included. Use a date "
"field."
msgstr ""
"Només dona estil a una biblioteca de calendari, que no hi és inclosa. Fes"
" servir un camp de data."

msgid ""
"Its button is a label, which a keyboard cannot reach: WCAG 2.1.1. The "
"shell uses a popover instead."
msgstr ""
"El seu botó és una etiqueta, que no s'abasta amb el teclat: WCAG 2.1.1. "
"L'estructura fa servir un plafó emergent."

msgid "Language"
msgstr "Idioma"

msgid "Layout"
msgstr "Estructura"

msgid "Layout, theme, language and how their controls look."
msgstr "Disposició, tema, idioma i com es veuen els seus controls."

msgid ""
"Leaves more room for the page. With the navigation at the top, the title "
"stays in the page."
msgstr ""
"Deixa més espai a la pàgina. Amb la navegació a dalt, el títol es queda a"
" la pàgina."

msgid "Light"
msgstr "Clar"

msgid "Links in the column headers sort the table inside each group."
msgstr ""
"Els enllaços de les capçaleres de columna ordenen la taula dins de cada "
"grup."

msgid "Links in the column headers sort the table."
msgstr "Els enllaços de les capçaleres de columna ordenen la taula."

msgid "Main"
msgstr "Principal"

msgid "Menu list"
msgstr "Llista de menú"

msgid "Mockups"
msgstr "Maquetes"

msgid "Moves on its own and only a pointer can pause it: WCAG 2.2.2."
msgstr "Es mou sol i només un punter el pot aturar: WCAG 2.2.2."

msgid "Navigation"
msgstr "Navegació"

msgid "Next page"
msgstr "Pàgina següent"

msgid "No"
msgstr "No"

msgid "No results"
msgstr "Sense resultats"

msgid "No results."
msgstr "Sense resultats."

msgid "Normal"
msgstr "Normal"

msgid "Not recommended"
msgstr "No recomanat"

msgid "Nothing matches. Try another word."
msgstr "Res no coincideix. Prova amb una altra paraula."

msgid "Number field"
msgstr "Camp numèric"

msgid ""
"On its own it changes the theme without saving it, and it cannot say that"
" the theme should follow the system. The shell uses its class inside a "
"form that saves the choice: see Settings."
msgstr ""
"Per si sol canvia el tema sense desar-lo i no pot indicar que el tema "
"segueixi el sistema. L'aplicació fa servir la seva classe dins d'un "
"formulari que desa l'elecció: consulta Configuració."

msgid "Open menu"
msgstr "Obre el menú"

#, python-format
msgid "Options: %(count)s"
msgstr "Opcions: %(count)s"

#, python-format
msgid "Page %(page)s"
msgstr "Pàgina %(page)s"

#, python-format
msgid "Page %(page)s of %(pages)s"
msgstr "Pàgina %(page)s de %(pages)s"

msgid "Page not found"
msgstr "No s'ha trobat la pàgina"

msgid "Page title"
msgstr "Títol de la pàgina"

msgid "Pages"
msgstr "Pàgines"

msgid "Preferences"
msgstr "Preferències"

msgid "Previous page"
msgstr "Pàgina anterior"

msgid "Radio"
msgstr "Opció"

#, python-format
msgid "Remove filter %(name)s: %(value)s"
msgstr "Treu el filtre %(name)s: %(value)s"

msgid "Remove the special characters, such as tabs, from this text."
msgstr "Treu d'aquest text els caràcters especials, com ara els tabuladors."

msgid "Rename the file so that it has one extension, such as report.pdf."
msgstr ""
"Canvia el nom del fitxer perquè tingui una sola extensió, com ara "
"informe.pdf."

msgid "Rename the file: its name cannot have a path or special characters."
msgstr "Canvia el nom del fitxer: no pot tenir una ruta ni caràcters especials."

msgid "Results"
msgstr "Resultats"

#, python-format
msgid "Results: %(count)s"
msgstr "Resultats: %(count)s"

msgid "Rows of lists"
msgstr "Files de les llistes"

msgid "Rows per page"
msgstr "Files per pàgina"

msgid ""
"Says that someone else saved first, and what they saved, above what was "
"typed."
msgstr ""
"Diu que una altra persona va desar abans, i què va desar, a sobre del que"
" s'ha escrit."

msgid "Search"
msgstr "Cerca"

msgid "Search is not available right now. Try again in a moment."
msgstr "La cerca no està disponible ara. Torna-ho a provar d'aquí a un moment."

msgid "Searchable select"
msgstr "Llista amb cerca"

msgid "Select"
msgstr "Llista"

msgid "Settings"
msgstr "Configuració"

msgid "Show the options"
msgstr "Mostra les opcions"

msgid "Side"
msgstr "Lateral"

msgid "Sign-in required"
msgstr "Cal iniciar sessió"

msgid "Skip to content"
msgstr "Salta al contingut"

msgid "Something went wrong"
msgstr "Alguna cosa ha fallat"

msgid "Start"
msgstr "Inici"

msgid "Swap"
msgstr "Intercanvi"

msgid "Text a person types as their language writes numbers. Never a float."
msgstr ""
"Text que cada persona escriu com el seu idioma escriu els nombres. Mai un"
" float."

msgid "That could not be read"
msgstr "No s'ha pogut llegir"

msgid "That did not work. Try again in a moment."
msgstr "No ha funcionat. Torna-ho a provar d'aquí a un moment."

msgid "That is too large to send"
msgstr "És massa gran per enviar-lo"

msgid ""
"That is too large to send. Choose a smaller file: what you typed is still"
" here."
msgstr ""
"És massa gran per enviar-lo. Tria un fitxer més petit: el que has escrit "
"continua aquí."

msgid "The browser's own date field, read by the server in one strict form."
msgstr ""
"El camp de data del mateix navegador, que el servidor llegeix en una "
"única forma estricta."

msgid "The file is empty. Choose one with something in it."
msgstr "El fitxer és buit. Tria'n un que tingui contingut."

#, python-format
msgid "The file must be %(most)s or smaller."
msgstr "El fitxer ha d'ocupar %(most)s o menys."

#, python-format
msgid "The file must be one of these: %(kinds)s."
msgstr "El fitxer ha de ser un d'aquests: %(kinds)s."

msgid "The main action of a form, the way out, and anything else at the far end."
msgstr ""
"L'acció principal d'un formulari, la sortida, i qualsevol altra cosa a "
"l'altre extrem."

msgid ""
"The name of this file does not match what it holds. Rename it, or choose "
"another."
msgstr ""
"El nom d'aquest fitxer no coincideix amb el que conté. Canvia'l o tria'n "
"un altre."

msgid "The server cannot be reached. Check your connection and try again."
msgstr ""
"No es pot contactar amb el servidor. Revisa la connexió i torna-ho a "
"provar."

msgid "Theme"
msgstr "Tema"

msgid "Theme and language"
msgstr "Tema i idioma"

msgid "This application is ready. Replace this page with your first screen."
msgstr ""
"Aquesta aplicació està a punt. Substitueix aquesta pàgina per la teva "
"primera pantalla."

msgid ""
"This is no longer here: someone may have removed it. Reload the page to "
"see what there is now."
msgstr ""
"Això ja no és aquí: potser algú ho ha tret. Recarrega la pàgina per veure"
" què hi ha ara."

msgid "This is not on the list. Choose one of its options."
msgstr "Això no és a la llista. Tria una de les seves opcions."

#, python-format
msgid "This is not really a %(kind)s file. Choose another."
msgstr "En realitat no és un fitxer %(kind)s. Tria'n un altre."

msgid "Tick the box or leave it empty."
msgstr "Marca la casella o deixa-la buida."

msgid "Toggle"
msgstr "Interruptor"

msgid "Top"
msgstr "Superior"

msgid "Try another word, or a shorter one."
msgstr "Prova amb una altra paraula, o amb una de més curta."

msgid "Type to search"
msgstr "Escriu per cercar"

#, python-format
msgid "Use %(most)s characters at most."
msgstr "Fes servir %(most)s caràcters com a màxim."

#, python-format
msgid "Use %(places)s decimal at most."
msgid_plural "Use %(places)s decimals at most."
msgstr[0] "Fes servir %(places)s decimal com a màxim."
msgstr[1] "Fes servir %(places)s decimals com a màxim."

msgid "Use this one"
msgstr "Fes servir aquest"

#, python-format
msgid "Version %(version)s"
msgstr "Versió %(version)s"

msgid "Warning"
msgstr "Avís"

msgid "We could not tell who you are. Open the application from your portal."
msgstr "No hem pogut saber qui ets. Obre l'aplicació des del teu portal."

msgid "What is wrong with one field, and how to fix it, tied to that field."
msgstr "Què falla en un camp i com arreglar-ho, vinculat a aquest camp."

msgid "Whole width"
msgstr "Tota l'amplada"

msgid "Width"
msgstr "Amplada"

msgid "Width of lists"
msgstr "Amplada de les llistes"

msgid "Yes"
msgstr "Sí"

msgid "You do not have permission"
msgstr "No tens permís"

msgid "You do not have permission to do this."
msgstr "No tens permís per fer això."

msgid "ascending"
msgstr "ascendent"

msgid "descending"
msgstr "descendent"

msgid "to close"
msgstr "per tancar"

msgid "to move"
msgstr "per moure't"

msgid "to open"
msgstr "per obrir"

