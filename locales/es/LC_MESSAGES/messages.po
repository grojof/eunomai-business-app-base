#, python-format
msgid ""
"%(count)s. Showing %(first)s to %(last)s, sorted by %(column)s, "
"%(direction)s."
msgstr ""
"%(count)s. Se muestran del %(first)s al %(last)s, ordenados por "
"%(column)s, %(direction)s."

msgid "(optional)"
msgstr "(opcional)"

msgid ""
"A figure with its text summary and its data as a table, drawn with "
"Chart.js."
msgstr ""
"Una figura con su resumen en texto y sus datos en una tabla, dibujada con"
" Chart.js."

msgid "A list of terms and their values, for one record's details."
msgstr "Una lista de términos y sus valores, para los detalles de un registro."

msgid "A list to type in, by keyboard, that is a plain select without JavaScript."
msgstr ""
"Una lista en la que se puede escribir, con el teclado, que sin JavaScript"
" es un select normal."

msgid ""
"A plain form that filters a list on the server. daisyUI's filter is a set"
" of radio buttons."
msgstr ""
"Un formulario sencillo que filtra una lista en el servidor. El filter de "
"daisyUI es un grupo de botones de opción."

msgid "Actions"
msgstr "Acciones"

msgid "Apply"
msgstr "Aplicar"

msgid "Approved"
msgstr "Aprobado"

msgid "As the system"
msgstr "Como el sistema"

msgid "Ask whoever manages this application if you need access."
msgstr "Si necesitas acceso, pídelo a quien gestiona esta aplicación."

msgid "Asks before an action that cannot be undone, and names what will be lost."
msgstr ""
"Pregunta antes de una acción que no se puede deshacer y dice qué se "
"perderá."

msgid "Available"
msgstr "Disponible"

msgid "Back to the start"
msgstr "Volver al inicio"

msgid "Breadcrumbs"
msgstr "Migas de pan"

msgid "Centred"
msgstr "Centrado"

msgid ""
"Change how this application looks for you. Each choice applies at once "
"and is remembered in this browser."
msgstr ""
"Cambia cómo se ve esta aplicación para ti. Cada opción se aplica al "
"momento y se recuerda en este navegador."

msgid "Chart"
msgstr "Gráfico"

msgid "Check the address, or go back to the start."
msgstr "Comprueba la dirección o vuelve al inicio."

msgid "Clear all"
msgstr "Quitar todos"

msgid "Close"
msgstr "Cerrar"

msgid "Close this message"
msgstr "Cerrar este mensaje"

msgid "Compact"
msgstr "Compacta"

msgid "Confirmation dialog"
msgstr "Diálogo de confirmación"

msgid "Copied"
msgstr "Copiado"

msgid "Copy"
msgstr "Copiar"

msgid "Dark"
msgstr "Oscuro"

msgid "Dark theme"
msgstr "Tema oscuro"

msgid "Data display"
msgstr "Mostrar datos"

msgid "Data input"
msgstr "Entrada de datos"

msgid "Data table"
msgstr "Tabla de datos"

msgid "Date field"
msgstr "Campo de fecha"

msgid "Decorative"
msgstr "Decorativo"

msgid "Density"
msgstr "Densidad"

msgid "Description list"
msgstr "Lista de descripciones"

msgid "Done"
msgstr "Hecho"

msgid "Dropdown"
msgstr "Desplegable"

msgid "Each one is real: try it here, then choose the one the header should show."
msgstr "Cada uno es real: pruébalo aquí y elige el que debe mostrar la cabecera."

#, python-format
msgid "Enter a date between %(earliest)s and %(latest)s."
msgstr "Escribe una fecha entre %(earliest)s y %(latest)s."

#, python-format
msgid "Enter a number between %(low)s and %(high)s."
msgstr "Escribe un número entre %(low)s y %(high)s."

#, python-format
msgid "Enter a number, such as %(example)s."
msgstr "Escribe un número, por ejemplo %(example)s."

#, python-format
msgid "Enter a whole number between %(low)s and %(high)s."
msgstr "Escribe un número entero entre %(low)s y %(high)s."

msgid "Error"
msgstr "Error"

msgid "Error summary"
msgstr "Resumen de errores"

msgid "Every problem of a form in one place, each a link to its field."
msgstr ""
"Todos los problemas de un formulario en un solo lugar, cada uno con un "
"enlace a su campo."

msgid "Feedback"
msgstr "Avisos"

msgid "Field error"
msgstr "Error de campo"

msgid "Filter bar"
msgstr "Barra de filtros"

msgid "Filters"
msgstr "Filtros"

msgid "Fixed header"
msgstr "Cabecera fija"

msgid "Form actions"
msgstr "Acciones del formulario"

msgid "Full"
msgstr "Completa"

msgid "Go back and try again. If it happens again, tell whoever runs this."
msgstr ""
"Vuelve atrás e inténtalo de nuevo. Si vuelve a pasar, avisa a quien "
"gestiona esto."

msgid "Hidden"
msgstr "Oculta"

msgid "How the language control looks"
msgstr "Cómo se ve el control de idioma"

msgid "How the theme control looks"
msgstr "Cómo se ve el control de tema"

msgid "Icons only"
msgstr "Solo iconos"

msgid "In use"
msgstr "En uso"

msgid "Information"
msgstr "Información"

msgid "It is not your fault. Try again in a moment."
msgstr "No es culpa tuya. Vuelve a intentarlo en un momento."

msgid ""
"It only styles a calendar library, which is not included. Use a date "
"field."
msgstr ""
"Solo da estilo a una biblioteca de calendario, que no está incluida. Usa "
"un campo de fecha."

msgid ""
"Its button is a label, which a keyboard cannot reach: WCAG 2.1.1. The "
"shell uses a popover instead."
msgstr ""
"Su botón es una etiqueta, que no se alcanza con el teclado: WCAG 2.1.1. "
"El armazón usa en su lugar un panel emergente."

msgid "Language"
msgstr "Idioma"

msgid "Layout"
msgstr "Estructura"

msgid "Layout, theme, language and how their controls look."
msgstr "Disposición, tema, idioma y cómo se ven sus controles."

msgid "Light"
msgstr "Claro"

msgid "Links in the column headers sort the table inside each group."
msgstr ""
"Los enlaces de las cabeceras de columna ordenan la tabla dentro de cada "
"grupo."

msgid "Links in the column headers sort the table."
msgstr "Los enlaces de las cabeceras de columna ordenan la tabla."

msgid "Main"
msgstr "Principal"

msgid "Menu list"
msgstr "Lista de menú"

msgid "Mockups"
msgstr "Maquetas"

msgid "Moves on its own and only a pointer can pause it: WCAG 2.2.2."
msgstr "Se mueve solo y solo un puntero puede pausarlo: WCAG 2.2.2."

msgid "Navigation"
msgstr "Navegación"

msgid "Next page"
msgstr "Página siguiente"

msgid "No"
msgstr "No"

msgid "No results"
msgstr "Sin resultados"

msgid "No results."
msgstr "Sin resultados."

msgid "Normal"
msgstr "Normal"

msgid "Not recommended"
msgstr "No recomendado"

msgid "Nothing matches. Try another word."
msgstr "Nada coincide. Prueba con otra palabra."

msgid "Number field"
msgstr "Campo numérico"

msgid ""
"On its own it changes the theme without saving it, and it cannot say that"
" the theme should follow the system. The shell uses its class inside a "
"form that saves the choice: see Settings."
msgstr ""
"Por sí solo cambia el tema sin guardarlo y no puede indicar que el tema "
"siga al sistema. La aplicación usa su clase dentro de un formulario que "
"guarda la elección: consulta Ajustes."

msgid "Open menu"
msgstr "Abrir el menú"

#, python-format
msgid "Options: %(count)s"
msgstr "Opciones: %(count)s"

#, python-format
msgid "Page %(page)s"
msgstr "Página %(page)s"

#, python-format
msgid "Page %(page)s of %(pages)s"
msgstr "Página %(page)s de %(pages)s"

msgid "Page not found"
msgstr "Página no encontrada"

msgid "Pages"
msgstr "Páginas"

msgid "Preferences"
msgstr "Preferencias"

msgid "Previous page"
msgstr "Página anterior"

msgid "Radio"
msgstr "Opción"

#, python-format
msgid "Remove filter %(name)s: %(value)s"
msgstr "Quitar el filtro %(name)s: %(value)s"

msgid "Remove the special characters, such as tabs, from this text."
msgstr "Quita de este texto los caracteres especiales, como los tabuladores."

msgid "Results"
msgstr "Resultados"

#, python-format
msgid "Results: %(count)s"
msgstr "Resultados: %(count)s"

msgid "Rows per page"
msgstr "Filas por página"

msgid "Search"
msgstr "Buscar"

msgid "Search is not available right now. Try again in a moment."
msgstr "La búsqueda no está disponible ahora. Inténtalo de nuevo en un momento."

msgid "Searchable select"
msgstr "Lista con búsqueda"

msgid "Select"
msgstr "Lista"

msgid "Settings"
msgstr "Ajustes"

msgid "Show the options"
msgstr "Mostrar las opciones"

msgid "Side"
msgstr "Lateral"

msgid "Sign-in required"
msgstr "Hay que iniciar sesión"

msgid "Skip to content"
msgstr "Saltar al contenido"

msgid "Something went wrong"
msgstr "Algo ha fallado"

msgid "Start"
msgstr "Inicio"

msgid "Swap"
msgstr "Intercambio"

msgid "Text a person types as their language writes numbers. Never a float."
msgstr ""
"Texto que cada persona escribe como su idioma escribe los números. Nunca "
"un float."

msgid "That could not be read"
msgstr "No se ha podido leer"

msgid "That did not work. Try again in a moment."
msgstr "No ha funcionado. Vuelve a intentarlo en un momento."

msgid "The browser's own date field, read by the server in one strict form."
msgstr ""
"El campo de fecha del propio navegador, que el servidor lee en una única "
"forma estricta."

msgid "The main action of a form, the way out, and anything else at the far end."
msgstr ""
"La acción principal de un formulario, la salida, y cualquier otra cosa al"
" otro extremo."

msgid "The server cannot be reached. Check your connection and try again."
msgstr ""
"No se puede contactar con el servidor. Revisa tu conexión y vuelve a "
"intentarlo."

msgid "Theme"
msgstr "Tema"

msgid "Theme and language"
msgstr "Tema e idioma"

msgid "This application is ready. Replace this page with your first screen."
msgstr "Esta aplicación está lista. Sustituye esta página por tu primera pantalla."

msgid ""
"This is no longer here: someone may have removed it. Reload the page to "
"see what there is now."
msgstr ""
"Esto ya no está aquí: quizá alguien lo ha quitado. Recarga la página para"
" ver lo que hay ahora."

msgid "Tick the box or leave it empty."
msgstr "Marca la casilla o déjala vacía."

msgid "Toggle"
msgstr "Interruptor"

msgid "Top"
msgstr "Superior"

msgid "Try another word, or a shorter one."
msgstr "Prueba con otra palabra, o con una más corta."

msgid "Type to search"
msgstr "Escribe para buscar"

#, python-format
msgid "Use %(most)s characters at most."
msgstr "Usa %(most)s caracteres como máximo."

#, python-format
msgid "Use %(places)s decimal at most."
msgid_plural "Use %(places)s decimals at most."
msgstr[0] "Usa %(places)s decimal como máximo."
msgstr[1] "Usa %(places)s decimales como máximo."

msgid "Use this one"
msgstr "Usar este"

#, python-format
msgid "Version %(version)s"
msgstr "Versión %(version)s"

msgid "Warning"
msgstr "Aviso"

msgid "We could not tell who you are. Open the application from your portal."
msgstr "No hemos podido saber quién eres. Abre la aplicación desde tu portal."

msgid "What is wrong with one field, and how to fix it, tied to that field."
msgstr "Qué falla en un campo y cómo arreglarlo, vinculado a ese campo."

msgid "Width"
msgstr "Anchura"

msgid "Yes"
msgstr "Sí"

msgid "You do not have permission"
msgstr "No tienes permiso"

msgid "You do not have permission to do this."
msgstr "No tienes permiso para hacer esto."

msgid "ascending"
msgstr "ascendente"

msgid "descending"
msgstr "descendente"

msgid "to close"
msgstr "para cerrar"

msgid "to move"
msgstr "para moverse"

msgid "to open"
msgstr "para abrir"

